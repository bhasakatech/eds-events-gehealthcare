{
  "definitions": [
    {
      "title": "FAQ Details",
      "id": "faq-details",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "FAQ Details",
              "model": "faq-details",
              "filter": "faq-details"
            }
          }
        }
      }
    },
    {
      "title": "FAQ Item",
      "id": "faq-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "FAQ Item",
              "model": "faq-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "faq-details",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "Style Variant",
          "description": "Block option applied as a CSS class on the block.",
          "valueType": "string",
          "value": "",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Compact", "value": "compact" },
            { "name": "Bordered", "value": "bordered" }
          ]
        },
        {
          "component": "tab",
          "label": "Heading",
          "name": "tabHeading"
        },
        {
          "component": "text",
          "name": "heading_title",
          "label": "Title",
          "description": "Main FAQ section heading (text field).",
          "valueType": "string",
          "value": "",
          "validation": {
            "maxLength": 120,
            "customErrorMsg": "Title must be 120 characters or fewer."
          }
        },
        {
          "component": "select",
          "name": "heading_titleType",
          "label": "Title Heading Level",
          "description": "Select field collapsed with title via titleType suffix.",
          "valueType": "string",
          "value": "h2",
          "options": [
            { "name": "H2", "value": "h2" },
            { "name": "H3", "value": "h3" },
            { "name": "H4", "value": "h4" }
          ]
        },
        {
          "component": "richtext",
          "name": "heading_intro",
          "label": "Introduction",
          "description": "Rich text intro under the title.",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "textarea",
          "name": "heading_summary",
          "label": "Summary",
          "description": "Plain multi-line summary (textarea, no formatting).",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "tab",
          "label": "Details",
          "name": "tabDetails"
        },
        {
          "component": "container",
          "name": "details",
          "label": "FAQ Details",
          "description": "Container groups related fields in the properties panel.",
          "collapsible": true,
          "fields": [
            {
              "component": "reference",
              "name": "details_image",
              "label": "Image",
              "description": "Asset picker (reference). Pair with Alt via field collapse.",
              "valueType": "string",
              "multi": false
            },
            {
              "component": "text",
              "name": "details_imageAlt",
              "label": "Image Alt Text",
              "valueType": "string",
              "value": ""
            },
            {
              "component": "boolean",
              "name": "details_expandFirst",
              "label": "Expand First Item",
              "description": "Boolean toggle — open the first FAQ item by default.",
              "valueType": "boolean",
              "value": false
            },
            {
              "component": "number",
              "name": "details_maxVisible",
              "label": "Max Visible Items",
              "description": "Number field — limit how many FAQ items to show (0 = all).",
              "valueType": "number",
              "value": 0,
              "validation": {
                "numberMin": 0,
                "numberMax": 50,
                "customErrorMsg": "Enter a number between 0 and 50."
              }
            },
            {
              "component": "date-time",
              "name": "details_publishDate",
              "label": "Publish Date",
              "description": "Date/time picker.",
              "valueType": "date"
            },
            {
              "component": "radio-group",
              "name": "details_layout",
              "label": "Layout",
              "description": "Radio group — mutually exclusive layout choice.",
              "valueType": "string",
              "value": "stacked",
              "options": [
                { "name": "Stacked", "value": "stacked" },
                { "name": "Two Column", "value": "two-column" }
              ]
            },
            {
              "component": "checkbox-group",
              "name": "details_features",
              "label": "Features",
              "description": "Checkbox group — multiple independent options.",
              "valueType": "string[]",
              "options": [
                { "name": "Show Search", "value": "show-search" },
                { "name": "Show Numbers", "value": "show-numbers" },
                { "name": "Allow Multiple Open", "value": "allow-multiple" }
              ]
            },
            {
              "component": "multiselect",
              "name": "details_topics",
              "label": "Topics",
              "description": "Multiselect — choose one or more topics.",
              "valueType": "string",
              "options": [
                {
                  "name": "Audience",
                  "children": [
                    { "name": "Patients", "value": "patients" },
                    { "name": "Providers", "value": "providers" },
                    { "name": "Partners", "value": "partners" }
                  ]
                },
                {
                  "name": "Format",
                  "children": [
                    { "name": "General", "value": "general" },
                    { "name": "Technical", "value": "technical" }
                  ]
                }
              ]
            },
            {
              "component": "aem-tag",
              "name": "details_tags",
              "label": "Tags",
              "description": "AEM tag picker.",
              "valueType": "string"
            },
            {
              "component": "aem-content",
              "name": "details_relatedPage",
              "label": "Related Page",
              "description": "AEM content picker (any resource, not only assets).",
              "valueType": "string",
              "validation": {
                "rootPath": "/content"
              }
            },
            {
              "component": "aem-content-fragment",
              "name": "details_contentFragment",
              "label": "Content Fragment",
              "description": "Content Fragment picker.",
              "valueType": "string",
              "variationName": "details_contentFragmentVariation",
              "validation": {
                "rootPath": "/content"
              }
            },
            {
              "component": "aem-experience-fragment",
              "name": "details_experienceFragment",
              "label": "Experience Fragment",
              "description": "Experience Fragment picker.",
              "valueType": "string",
              "variationName": "details_experienceFragmentVariation",
              "validation": {
                "rootPath": "/content"
              }
            }
          ]
        },
        {
          "component": "tab",
          "label": "Help",
          "name": "tabHelp"
        },
        {
          "component": "container",
          "name": "help",
          "label": "Author Help Links",
          "description": "Second container example with a CTA link (field collapse).",
          "collapsible": true,
          "fields": [
            {
              "component": "aem-content",
              "name": "help_cta",
              "label": "Help Link",
              "valueType": "string"
            },
            {
              "component": "text",
              "name": "help_ctaText",
              "label": "Help Link Label",
              "valueType": "string",
              "value": "Learn more"
            },
            {
              "component": "text",
              "name": "help_ctaTitle",
              "label": "Help Link Title",
              "description": "Optional title attribute on the link.",
              "valueType": "string",
              "value": ""
            },
            {
              "component": "select",
              "name": "help_ctaType",
              "label": "Help Link Style",
              "valueType": "string",
              "value": "",
              "options": [
                { "name": "Default", "value": "" },
                { "name": "Primary", "value": "primary" },
                { "name": "Secondary", "value": "secondary" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "faq-item",
      "fields": [
        {
          "component": "text",
          "name": "question",
          "label": "Question",
          "valueType": "string",
          "value": "",
          "required": true
        },
        {
          "component": "richtext",
          "name": "answer",
          "label": "Answer",
          "valueType": "string",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "faq-details",
      "components": [
        "faq-item"
      ]
    }
  ]
}
